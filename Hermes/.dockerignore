# Exclude WSL2 venv (symlinks break docker build)
.venv/
venv/
env/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Tests run in CI, not in the runtime image
tests/

# Local config — NEVER bake secrets into image
.env
.env.*
!.env.example
*.bak
*.bak.*
.env.bak*

# IDE
.vscode/
.idea/

# Git
.git/
.gitignore

# Logs
*.log
