# AGNT SCALE — Hermes runtime env. Copy to Hermes/.env and fill in real values.
# NEVER commit the filled-in .env (gitignored).

HERMES_PORT=7777
HERMES_HOST=0.0.0.0
APP_ENV=production
LOG_LEVEL=info

# Long random shared secret; Backend/Vercel must send it as X-Internal-Token.
HERMES_INTERNAL_TOKEN=__generate_a_long_random_token__
ALLOWED_ORIGINS=*

# Postgres (asyncpg/SQLAlchemy form; the memory client strips +asyncpg for asyncpg).
# Host "postgres" = the agnt-postgres compose service. Password must match root .env POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://agnt:__db_password__@postgres:5432/agnt
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333

# OpenRouter (LLM)
OPENROUTER_API_KEY=sk-or-v1-__your_openrouter_key__
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# Fernet master key for at-rest encryption (urlsafe base64, 32 bytes).
FERNET_MASTER_KEY=__generate_fernet_key__

# fal.ai (optional, media generation)
FAL_KEY=__optional__

# Manus AI — desired provider for the Ad Setting agent; wire when its API spec is available.
MANUS_API_KEY=__your_manus_key__

# Local self-hosted embeddings (no API key). Override to swap the model.
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
FASTEMBED_CACHE_PATH=/home/app/.fastembed_cache

# ── Agent memory maintenance (#12) — all off / dry-run by default ─────────────
# MEM_TTL_DAYS=0              # delete rows older than N days (0=off); MEM_TTL_SCOPE=short|long|all
# MEM_MAX_PER_AGENT=0         # cap rows per (account_id, agent_id) (0=off), evict oldest
# MEM_DEDUP_EXACT=0           # collapse identical content (md5) within a bucket (opt-in)
# MEM_DEDUP_COSINE=0          # near-duplicate long rows by embedding similarity (e.g. 0.97)
# MEM_MAINT_DRY_RUN=1         # 1=log only; 0=actually DELETE (needs human approval)
# MEM_MAINT_SKIP_ACCOUNTS=_global
# MEM_MAINT_SCHEDULE=0        # 1=APScheduler interval inside agnt-hermes
# MEM_MAINT_INTERVAL_HOURS=24
# MEM_EXPIRES_SHORT_DAYS=7       # expires_at on new short-scope rows (0=NULL)
# MEM_EXPIRES_LONG_DAYS=0        # expires_at on new long-scope rows (0=NULL, default never)
